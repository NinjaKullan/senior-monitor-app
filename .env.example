# Copy to .env for local development. NEVER commit a filled-in copy.
# In production these are Fly secrets, not files:
#   fly secrets set PING_TOKEN=... NTFY_TOPIC=... IP_HASH_SALT=...

# Shared secret required on every request (?token=...). No default — the app
# refuses to start without it. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
PING_TOKEN=

# ntfy.sh topic for FOUNDER-ONLY alerts. The topic string is the only
# authentication ntfy has, so treat it as a secret and make it unguessable:
#   python -c "import secrets; print('kettle-' + secrets.token_urlsafe(12))"
# Leave empty to run log-only (alerts are still recorded in the DB).
NTFY_TOPIC=

# SQLite location. /data is the Fly volume; use ./pilot.db locally.
DB_PATH=/data/pilot.db

# Display timezone. Storage is always UTC.
TZ_DISPLAY=Asia/Kolkata

# Salt for the truncated one-way IP hash (ops/debug only, never displayed).
# If unset, a fresh random salt is generated per boot, which means hashes
# stop correlating across restarts.
IP_HASH_SALT=

# Set to 0 to disable the in-process heartbeat monitor (used by tests).
HEARTBEAT_LOOP=1

# --- kettle-api (product/) — Fly secrets / [env], not files -------------------

# Spec 007 outbound channel. LOOP runs the scheduler as a background task;
# ENABLED is the live kill switch on the decisions themselves. Both are "1"
# in product/fly.toml.
OUTBOUND_LOOP=0
OUTBOUND_ENABLED=0

# Which registered transport the loop uses: "console" (default — the dark
# transport: ledger written, nothing sent) or "resend" (Wave B: digests to the
# child's account email). An unknown name, or resend without its key, refuses
# to boot. The founder flips this to resend AFTER the Wave A ledger review:
#   fly secrets set -a kettle-api RESEND_API_KEY=re_... OUTBOUND_TRANSPORT=resend
# (Fly secrets override [env], so no code change and no fly.toml edit.)
OUTBOUND_TRANSPORT=console

# Resend API key. Read only when OUTBOUND_TRANSPORT=resend, then required.
RESEND_API_KEY=

# From address for digests; defaults to the verified sending subdomain
# (docs/auth-smtp-plan.md). Replies go to a human via reply-to.
RESEND_FROM=

# Shared secret for /outbound/reply; empty means the endpoint does not exist.
OUTBOUND_REPLY_TOKEN=
# Spec 012: the first_reply journal line. OFF until the Wave D Phase 3
# flip - it belongs to the real-number era, never a sandbox reply.
MEMORY_FIRST_REPLY=0

# Wave C: the ask to the parent by WhatsApp (Twilio sandbox). All three
# required when OUTBOUND_TRANSPORT selects twilio_whatsapp; the auth token
# also verifies inbound reply signatures on /outbound/reply.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Wave D Phase 2 (spec 011 par.4): the approved ask template's Content SID.
# SET = the ask goes as a template, which is the only way a real registered
# number may START a conversation. UNSET = the sandbox's body send, unchanged.
# The approved template is kettle_ask_parent_v4 (DECISIONS 206/207).
TWILIO_ASK_CONTENT_SID=

# --- The weekly site summary (DECISIONS 201/211/212) -------------------------
# Shared between BOTH apps: the site container's counter sends this token,
# kettle-api requires it. Unset on kettle-api means POST /site-metrics/daily
# does not exist (404) — the same fail-closed shape OUTBOUND_REPLY_TOKEN uses.
# Unset on kettle-site means the counter never counts and the image serves
# exactly as it did before. Generate one:
#   python -c "import secrets; print('kettle-metrics-' + secrets.token_urlsafe(16))"
#   fly secrets set -a kettle-api  SITE_METRICS_TOKEN=...
#   fly secrets set -a kettle-site SITE_METRICS_TOKEN=...
SITE_METRICS_TOKEN=

# kettle-api only: where the Monday 9:00am ET note goes. Founder-only; empty
# means no weekly email is sent, so an unconfigured deploy is quiet rather
# than broken. Nothing family-facing can ever reach this address (law #3).
SITE_METRICS_EMAIL=

# kettle-site only: where the counter POSTs its daily counts, and how often it
# flushes. The interval is well under a day on purpose — the site app runs with
# auto_stop_machines, so a machine that stops at 11pm never reaches a midnight
# flush; the endpoint keeps a high-water mark, so re-sending a running total
# costs nothing and a lost flush is harmless.
SITE_METRICS_ENDPOINT=https://kettle-api.fly.dev/site-metrics/daily
SITE_METRICS_INTERVAL_S=300
