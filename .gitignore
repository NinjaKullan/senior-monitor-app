# Secrets — never commit real values
.env
*.env.local

# Data — pilot pings never go to GitHub
*.db
*.sqlite*
data/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# OS/editor
.DS_Store

# Webapp build + deps
node_modules/
webapp/dist/
site/dist/
site/dist-ssr/
.env.local

# Shortcut forge output (spec 005e) — every one of these files contains a live
# device token, so both the default output directory and the file extension
# anywhere in the tree are ignored. product/tests/test_forge.py asserts it via
# `git check-ignore`, including that the assertion can fail.
out/
*.shortcut

# Experiment §5.1 (DECISIONS 102): staged signed shortcuts served by kettle-app.
# Each carries a live device token; the slug directory must never reach git.
# (*.shortcut is already ignored tree-wide; this covers notes or unsigned
# copies dropped beside one.)
webapp/public/x/
