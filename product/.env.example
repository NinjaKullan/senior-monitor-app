# Copy to .env for local development. NEVER commit a filled-in copy.
# In production these are Fly secrets, not files:
#   fly secrets set DATABASE_URL=... NTFY_TOPIC=... IP_HASH_SALT=...

# Supabase Postgres connection string for the SERVICE role. Supabase Settings →
# Database → Connection string (use the pooler URI for production). This
# credential bypasses RLS by design — the ingestion service must write for every
# family. It is the most sensitive value in the system; never expose it to a
# client. No default: the app refuses to start without it.
DATABASE_URL=

# ntfy.sh topic for OPS alerts (heartbeat, pipeline silence). Founder only —
# nothing family- or parent-facing is ever sent (product law #3). The topic
# string is the only authentication ntfy has, so make it unguessable:
#   python -c "import secrets; print('kettle-ops-' + secrets.token_urlsafe(12))"
# Leave empty to run log-only; alerts are still recorded in ops_alerts.
NTFY_TOPIC=

# Salt for the truncated one-way IP hash (ops/debug only, never displayed).
# If unset, a fresh random salt is generated per boot, which means hashes stop
# correlating across restarts.
IP_HASH_SALT=

# Default family timezone at provisioning time.
DEFAULT_TZ=Asia/Kolkata

# Base URL printed into provisioned ping URLs and shortcuts.
PUBLIC_BASE_URL=https://kettle-api.fly.dev

# Set to 0 to disable the in-process background loops (used by tests).
HEARTBEAT_LOOP=1

# Tests only: where the throwaway test database lives. Defaults to
# postgresql://postgres:postgres@127.0.0.1:5432/kettle_test — the standard CI
# service-container credentials, not a secret.
TEST_DATABASE_URL=

# --- Retired with specs 003 and 004 (DECISIONS 141) --------------------------
# DIGEST_ENABLED, DIGEST_MORNING_CUTOFF_HOUR, DIGEST_EVENING_HOUR,
# DIGEST_EVENING_MINUTE, LADDER_ENABLED, TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN
# and TWILIO_FROM are gone. Nothing reads them, and a variable that looks
# configured while nothing reads it is worse than an absent one. Wave C re-adds
# a Twilio credential when there is a transport to spend it on.

# --- The outbound channel (spec 007) -----------------------------------------
# Wave A runs the decision core dark: it evaluates each day, writes its ledger,
# and hands every message to a transport that only writes a log line. Turning
# this on therefore reaches nobody — the wave that adds a transport which does
# is gated on a founder errand. Off by default like every other sending path.
OUTBOUND_ENABLED=0

# The shared secret /outbound/reply requires. **Empty means the route does not
# exist** (404), which is deliberate: cancelling a follow-on is a safety-
# relevant act, and an unauthenticated endpoint would let anyone who knows a
# number suppress an escalation. Wave C replaces this with the provider's own
# signature, the way /twilio/inbound already validates Twilio's.
OUTBOUND_REPLY_TOKEN=
# Spec 012: the first_reply journal line. OFF until the Wave D Phase 3
# flip - it belongs to the real-number era, never a sandbox reply.
MEMORY_FIRST_REPLY=0

# Spec 019 — ask Kettle from an assistant. The family app's origin (where
# /oauth/authorize sends the person for consent) and the Supabase project's
# JWKS, which /oauth/approve verifies sessions against (ES256). Both are
# founder values; the JWKS URL empty means approve refuses every session.
APP_ORIGIN=https://kettle-app.fly.dev
SUPABASE_JWKS_URL=
